{
  "$defs": {
    "AllRulesConfig": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "items": {
            "$ref": "#/$defs/RuleConfig"
          },
          "minItems": 2,
          "title": "All",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "all"
      ],
      "title": "AllRulesConfig",
      "type": "object"
    },
    "CILayer": {
      "additionalProperties": false,
      "properties": {
        "expected": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CheckSelector"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "ignore": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CheckSelector"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ignore"
        },
        "min_successful_checks": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Successful Checks"
        }
      },
      "title": "CILayer",
      "type": "object"
    },
    "CheckSelector": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "required": [
        "name"
      ],
      "title": "CheckSelector",
      "type": "object"
    },
    "HumanReviewLayer": {
      "additionalProperties": false,
      "properties": {
        "comment": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        },
        "mention": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mention"
        }
      },
      "title": "HumanReviewLayer",
      "type": "object"
    },
    "LimitsLayer": {
      "additionalProperties": false,
      "properties": {
        "exclude_from_line_count": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclude From Line Count"
        },
        "max_changed_lines": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Changed Lines"
        }
      },
      "title": "LimitsLayer",
      "type": "object"
    },
    "MergeLayer": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "anyOf": [
            {
              "enum": [
                "merge",
                "squash",
                "rebase"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        }
      },
      "title": "MergeLayer",
      "type": "object"
    },
    "MergeRisk": {
      "enum": [
        "minimal",
        "low",
        "moderate",
        "high",
        "critical"
      ],
      "title": "MergeRisk",
      "type": "string"
    },
    "ProfileRuleConfig": {
      "additionalProperties": false,
      "properties": {
        "profile": {
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "profile"
      ],
      "title": "ProfileRuleConfig",
      "type": "object"
    },
    "ReviewLayer": {
      "additionalProperties": false,
      "properties": {
        "max_finding_severity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Severity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_merge_risk": {
          "anyOf": [
            {
              "$ref": "#/$defs/MergeRisk"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plugin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plugin"
        }
      },
      "title": "ReviewLayer",
      "type": "object"
    },
    "RuleConfig": {
      "additionalProperties": false,
      "properties": {
        "max": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "max_changed_lines": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Changed Lines"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "options": {
          "additionalProperties": true,
          "title": "Options",
          "type": "object"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "title": "Paths",
          "type": "array"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "statuses": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "modified",
                  "added",
                  "removed",
                  "renamed",
                  "copied",
                  "changed",
                  "unchanged"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statuses"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "RuleConfig",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ci": {
      "anyOf": [
        {
          "$ref": "#/$defs/CILayer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "enabled": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Enabled"
    },
    "human_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/HumanReviewLayer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "limits": {
      "anyOf": [
        {
          "$ref": "#/$defs/LimitsLayer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "llm_context_files": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Llm Context Files"
    },
    "merge": {
      "anyOf": [
        {
          "$ref": "#/$defs/MergeLayer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "review": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewLayer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rules": {
      "anyOf": [
        {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/RuleConfig"
              },
              {
                "$ref": "#/$defs/AllRulesConfig"
              },
              {
                "$ref": "#/$defs/ProfileRuleConfig"
              }
            ]
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rules"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "trusted_authors": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trusted Authors"
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "ConfigLayer",
  "type": "object"
}
